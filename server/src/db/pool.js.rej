diff a/server/src/db/pool.js b/server/src/db/pool.js	(rejected hunks)
@@ -1,3 +1,14 @@
-import pg from "pg";
-const pool = new pg.Pool();
+import 'dotenv/config';
+import pg from 'pg';
+// PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD are read by node-postgres.
+// Use separate variables so connection-string sslmode cannot replace our TLS configuration.
+const pool = new pg.Pool({
+  max: 10,
+  connectionTimeoutMillis: 5000,
+  idleTimeoutMillis: 30000,
+  statement_timeout: 10000,
+  options: '-c timezone=Asia/Ho_Chi_Minh',
+  ssl: process.env.DATABASE_SSL === 'true' ? { rejectUnauthorized: true } : false,
+});
+pool.on('error', error => console.error('PostgreSQL idle connection error:', error.code || error.name));
 export default pool;
