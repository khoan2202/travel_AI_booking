# Cấu hình backend khi chạy trên máy (không dùng Docker). Sao chép thành server/.env rồi điền giá trị.
# File server/.env đã được .gitignore, không bị đưa lên GitHub.

# Cổng backend, và địa chỉ giao diện (dùng cho CORS).
PORT=5000
CLIENT_URL=http://localhost:5173

# Kết nối PostgreSQL.
PGHOST=localhost
PGPORT=5432
PGDATABASE=travel_ai_booking
PGUSER=travel_app
PGPASSWORD=replace_me

# Khóa ký cookie đăng nhập, bắt buộc, ít nhất 32 ký tự ngẫu nhiên. Tạo nhanh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=THAY_BANG_CHUOI_NGAU_NHIEN_DAI_IT_NHAT_32_KY_TU

# Không bắt buộc: bỏ trống thì trợ lý AI dùng phương án gợi ý từ database.
GEMINI_API_KEY=
# GEMINI_MODEL=

# Chỉ khi deploy thật (Render, Neon...):
# NODE_ENV=production          # bắt buộc CLIENT_URL là https và DATABASE_SSL=true
# DATABASE_SSL=true            # Neon và đa số dịch vụ database trên mạng bắt buộc SSL
# SERVE_CLIENT=true            # phục vụ luôn giao diện đã build (production tự bật)
