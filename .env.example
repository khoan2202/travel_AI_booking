# Cấu hình cho `docker compose up` (docker-compose.yml đọc file .env cùng thư mục).
# Sao chép thành .env rồi sửa. File .env đã được .gitignore, không bị đưa lên GitHub.
#
# Cấu hình khi chạy không dùng Docker nằm ở server/.env (xem server/.env.example) và client/.env.

# Mật khẩu của PostgreSQL trong container.
POSTGRES_PASSWORD=doi-mat-khau-nay

# Khóa ký cookie đăng nhập, ít nhất 32 ký tự ngẫu nhiên. Tạo nhanh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu

# Không bắt buộc. Lấy khóa miễn phí tại https://aistudio.google.com/apikey
# Bỏ trống: trợ lý AI vẫn chạy bằng phương án gợi ý từ database.
GEMINI_API_KEY=
GEMINI_MODEL=
